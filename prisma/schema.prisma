// L'Atelier — schéma de données
// Postgres uniquement (dev et prod), voir README pour le pourquoi.
//
// Le moteur est neutre : il connaît des modules, des compétences et des
// exercices. Ce qu'une compétence représente — une règle d'orthographe, une
// notion d'histoire, un mot d'espagnol — regarde le module, pas la base.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ─────────────────────────── CONTENU ───────────────────────────
 */

enum ContentStatus {
  active // servi en exercice, compté dans le score
  draft // rédigé mais pas encore relu, jamais servi
  disputed // usage partagé : présenté comme point de débat, jamais compté comme faute
}

/// Une matière. Ajouter un module, c'est ajouter une ligne ici et un fichier
/// dans src/modules/ — jamais une migration.
model Module {
  /// Identifiant lisible, repris dans les URL : "francais", "culture-g".
  id          String        @id
  name        String
  tagline     String
  position    Int
  /// Modèle de progression : "repetition-espacee" ou "scores".
  progression String        @default("repetition-espacee")
  status      ContentStatus @default(active)
  createdAt   DateTime      @default(now())

  skills     Skill[]
  categories Category[]
  dictations Dictation[]

  @@index([position])
}

model Category {
  id        String   @id @default(cuid())
  moduleId  String
  slug      String
  name      String
  position  Int
  createdAt DateTime @default(now())

  module          Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  skills          Skill[]
  defaultForUsers UserSettings[]

  /// Deux modules peuvent tous deux avoir une catégorie « Vocabulaire ».
  @@unique([moduleId, slug])
  @@unique([moduleId, name])
  @@index([moduleId, position])
}

/// Ce que le moteur appelle une compétence. Le module lui donne son nom :
/// « règle » en français, « notion » en culture générale, « carte » en langues.
model Skill {
  id         String        @id @default(cuid())
  moduleId   String
  slug       String        @unique // identifiant lisible, ex. "a-à" — repris du fichier d'origine
  categoryId String
  title      String // t
  statement  String // r — HTML léger, <b> uniquement
  tip        String // astuce
  difficulty Int // 1 à 3
  status     ContentStatus @default(active)
  batch      String? // lot de génération : "legacy" ou "batch-007"

  /// Le support de cours, quand la compétence en a un. Le moteur ne le lit
  /// jamais : il ne fait que le servir à l'écran de lecture.
  lesson Json?

  /// Niveau du cadre européen : "A1" à "C2". Null hors des langues.
  /// Sert à situer l'apprenant, pas à ordonner les séries — ça, c'est le
  /// palier qui s'en charge.
  level String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module     Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  category   Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  exercises  Exercise[]
  progress   SkillProgress[]
  dictations Dictation[]     @relation("DictationSkills")

  @@index([moduleId, status])
  @@index([moduleId, level, status])
  @@index([categoryId, status])
  @@index([status, difficulty])
}

/// Un exercice. Sa forme dépend de son `kind` ; la base ne l'interprète pas.
model Exercise {
  id      String @id @default(cuid())
  skillId String

  /// Type d'exercice : "spot-error", "qcm", "flashcard", "traduction", "ecoute".
  /// Le sens de `payload` en découle, et lui seul.
  kind String

  /// Charge utile propre au type. Le serveur la confie à ExerciseKind.grade()
  /// et n'en lit jamais le détail lui-même.
  payload Json

  /// Empreinte de dédoublonnage, produite par ExerciseKind.fingerprint().
  /// Unique : deux exercices jumeaux ne peuvent pas coexister.
  fingerprint String @unique

  difficulty Int
  status     ContentStatus @default(active)
  batch      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  skill    Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([skillId, status])
  @@index([kind])
}

model Dictation {
  id         String @id @default(cuid())
  moduleId   String @default("francais")
  /// Unique : garde-fou anti-doublon, et clé d'idempotence du seed.
  text       String @unique
  theme      String
  difficulty Int // 1 à 3

  /// Étiquette de voix pour la lecture : "fr-FR", "en-GB", "en-US", "es-MX".
  /// Varier l'accent d'une dictée à l'autre est le seul moyen d'habituer
  /// l'oreille à autre chose qu'à une seule prononciation.
  voice String  @default("fr-FR")
  /// Niveau du cadre européen, comme pour les compétences.
  level String?

  status    ContentStatus @default(active)
  batch     String?
  createdAt DateTime      @default(now())

  module   Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  skills   Skill[]            @relation("DictationSkills")
  attempts DictationAttempt[]

  @@index([moduleId, difficulty, status])
  @@index([moduleId, level])
  @@index([difficulty, status])
}

/**
 * ──────────────────── UTILISATEURS ET SESSIONS ────────────────────
 */

model User {
  id           String    @id @default(cuid())
  /// Email tel que saisi (affichage).
  email        String
  /// Email en minuscules — c'est LUI qui porte l'unicité (insensibilité à la casse).
  emailKey     String    @unique
  passwordHash String
  pseudo       String
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  /// Compteur global de questions répondues : l'horloge du planificateur.
  answerCounter   Int       @default(0)
  /// Date du test de positionnement, null s'il n'a pas été passé.
  placementDoneAt DateTime?

  sessions          Session[]
  progress          SkillProgress[]
  attempts          Attempt[]
  studySessions     StudySession[]
  dictationAttempts DictationAttempt[]
  settings          UserSettings?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 du token de session. Le token en clair ne touche jamais la base.
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  userId            String  @id
  /// Longueur de série préférée : 10, 20 ou 35.
  seriesLength      Int     @default(20)
  defaultCategoryId String?
  /// Options d'affichage (son des dictées, animations…), libre.
  options           Json    @default("{}")

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultCategory Category? @relation(fields: [defaultCategoryId], references: [id], onDelete: SetNull)
}

/**
 * ─────────────────────────── PROGRESSION ───────────────────────────
 */

model SkillProgress {
  userId  String
  skillId String

  /// Palier 0 à 5.
  box            Int       @default(0)
  /// Échéance exprimée en nombre de questions répondues (User.answerCounter), pas en date.
  dueAtCounter   Int       @default(0)
  seenCount      Int       @default(0)
  correctCount   Int       @default(0)
  lastReviewedAt DateTime?
  isNew          Boolean   @default(true)
  /// Dernier exercice servi : évite de le resservir deux fois de suite.
  lastExerciseId String?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([userId, skillId])
  @@index([userId, dueAtCounter]) // la requête du planificateur
  @@index([userId, isNew])
}

model Attempt {
  id             String   @id @default(cuid())
  userId         String
  exerciseId     String
  /// La réponse brute de l'utilisateur, telle que le type d'exercice l'attend :
  /// un rang pour un QCM ou un repérage, un booléen pour une carte, une
  /// chaîne pour une traduction.
  answer         Json
  isCorrect      Boolean
  studySessionId String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise     Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  studySession StudySession? @relation(fields: [studySessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([exerciseId])
}

enum StudySessionType {
  test
  training
  targeted
  weakness
  dictation
  /// Entraînement sur une seule compétence, lancé depuis sa fiche au catalogue.
  skill
}

model StudySession {
  id            String           @id @default(cuid())
  userId        String
  type          StudySessionType
  moduleId      String           @default("francais")
  category      String?
  /// Slug de la compétence travaillée, pour les séries de type `skill`.
  skillSlug     String?
  questionCount Int
  score         Int? // pourcentage, null tant que la série n'est pas finie
  startedAt     DateTime         @default(now())
  finishedAt    DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts Attempt[]

  @@index([userId, startedAt])
}

model DictationAttempt {
  id          String   @id @default(cuid())
  userId      String
  dictationId String
  /// Texte saisi par l'utilisateur.
  text        String
  score       Int // pourcentage de mots justes
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dictation Dictation @relation(fields: [dictationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * ───────────────── LIMITATION DE DÉBIT (sans Redis) ─────────────────
 */

enum AuthAction {
  login
  register
}

model AuthAttempt {
  id        String     @id @default(cuid())
  ip        String
  action    AuthAction
  createdAt DateTime   @default(now())

  @@index([ip, action, createdAt])
}
